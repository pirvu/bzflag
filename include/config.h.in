/* include/config.h.in - CMake configuration template for BZFlag */

/* Package information */
#define PACKAGE_NAME "BZFlag"
#define PACKAGE_VERSION "${PROJECT_VERSION}"
#define PACKAGE_STRING "BZFlag ${PROJECT_VERSION}"
#define PACKAGE_BUGREPORT "http://BZFlag.org/"
#define PACKAGE_TARNAME "bzflag"

/* BZFlag build date */
#define BUILD_DATE "${BUILD_DATE}"

/* BZFlag System Environment */
#define BZ_BUILD_OS "${BZ_BUILD_OS}"

/* Data file directory */
#cmakedefine BZFLAG_DATA "${BZFLAG_DATA}"

/* Enabling Robots */
#cmakedefine ROBOT 1

/* Enable plugins */
#cmakedefine BZ_PLUGINS 1

/* Debugging */
#cmakedefine DEBUG 1
#cmakedefine DEBUG_RENDERING 1
#cmakedefine NDEBUG 1

/* Half rate Audio */
#cmakedefine HALF_RATE_AUDIO 1

/* ===== Header checks ===== */
#cmakedefine HAVE_CMATH 1
#cmakedefine HAVE_CSTDLIB 1
#cmakedefine HAVE_CSTDIO 1
#cmakedefine HAVE_CSTRING 1
#cmakedefine HAVE_SDL2_SDL_H 1
#cmakedefine HAVE_BSTRING_H 1
#cmakedefine HAVE_DLFCN_H 1
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_LINUX_INPUT_H 1
#cmakedefine HAVE_MEMORY_H 1
#cmakedefine HAVE_NETDB_H 1
#cmakedefine HAVE_PROCESS_H 1
#cmakedefine HAVE_SCHED_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_SYS_PARAM_H 1
#cmakedefine HAVE_SYS_SOCKET_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_VALUES_H 1
#cmakedefine HAVE_REGEX_H 1
#cmakedefine HAVE_NCURSES_H 1
#cmakedefine HAVE_CURSES_H 1

/* ===== Function checks ===== */
#cmakedefine HAVE_CGLGETCURRENTCONTEXT 1
#cmakedefine HAVE_SLEEP 1
#cmakedefine HAVE_WAITFORSINGLEOBJECT 1
#cmakedefine HAVE__STRICMP 1
#cmakedefine HAVE__STRNICMP 1
#cmakedefine HAVE__VSNPRINTF 1
#cmakedefine HAVE_ATEXIT 1
#cmakedefine HAVE_HSTRERROR 1
#cmakedefine HAVE_SCHED_SETAFFINITY 1
#cmakedefine HAVE_SELECT 1
#cmakedefine HAVE_SNOOZE 1
#cmakedefine HAVE_USLEEP 1
#cmakedefine HAVE_VSNPRINTF 1
#cmakedefine HAVE_WGLGETCURRENTCONTEXT 1

/* ===== Math float function checks ===== */
#cmakedefine HAVE_ACOSF 1
#cmakedefine HAVE_ASINF 1
#cmakedefine HAVE_ATAN2F 1
#cmakedefine HAVE_ATANF 1
#cmakedefine HAVE_COSF 1
#cmakedefine HAVE_EXPF 1
#cmakedefine HAVE_FABSF 1
#cmakedefine HAVE_FLOORF 1
#cmakedefine HAVE_FMODF 1
#cmakedefine HAVE_HYPOTF 1
#cmakedefine HAVE_LOGF 1
#cmakedefine HAVE_LOG10F 1
#cmakedefine HAVE_POWF 1
#cmakedefine HAVE_SINF 1
#cmakedefine HAVE_SQRTF 1
#cmakedefine HAVE_TANF 1

/* ===== Library checks ===== */
#cmakedefine HAVE_LIBCURL 1
#cmakedefine HAVE_LIBDL 1
#cmakedefine HAVE_LIBM 1
#cmakedefine HAVE_LIBRT 1
#cmakedefine HAVE_ARES_GETADDRINFO 1

/* ===== Type checks ===== */
#cmakedefine SIZEOF_INT ${SIZEOF_INT}
#cmakedefine SIZEOF_SHORT_INT ${SIZEOF_SHORT_INT}
#cmakedefine SIZEOF_LONG_INT ${SIZEOF_LONG_INT}
#cmakedefine SIZEOF_LONG_LONG_INT ${SIZEOF_LONG_LONG_INT}
#cmakedefine SIZEOF_FLOAT ${SIZEOF_FLOAT}
#cmakedefine SIZEOF_DOUBLE ${SIZEOF_DOUBLE}
#cmakedefine SIZEOF_LONG_DOUBLE ${SIZEOF_LONG_DOUBLE}

/* socklen_t */
#cmakedefine HAVE_SOCKLEN_T 1

/* ===== Threading ===== */
#cmakedefine HAVE_PTHREADS 1
#cmakedefine _REENTRANT 1

/* ===== std:: checks ===== */
#cmakedefine HAVE_STD__ISNAN 1
#cmakedefine HAVE_ISNAN 1
#cmakedefine HAVE_STD__MIN 1
#cmakedefine HAVE_STD__MAX 1
#cmakedefine HAVE_STD__COUNT 1

/* ===== Linux force feedback ===== */
#cmakedefine HAVE_FF_EFFECT_RUMBLE 1
#cmakedefine HAVE_FF_EFFECT_DIRECTIONAL 1

/* ===== Emscripten ===== */
#cmakedefine EMSCRIPTEN_BUILD 1
