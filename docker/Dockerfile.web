# Multi-stage build: compile WASM, then serve with nginx
# Usage:
#   docker build -f docker/Dockerfile.web -t bzflag-web .
#   docker run -p 8080:80 bzflag-web
#   Open http://localhost:8080

# Stage 1: Build WASM
FROM emscripten/emsdk:3.1.74 AS build

WORKDIR /src
COPY . .

RUN mkdir -p build-emscripten && cd build-emscripten && \
    emcmake cmake .. \
      -DENABLE_CLIENT=ON \
      -DENABLE_SERVER=OFF \
      -DENABLE_BZADMIN=OFF && \
    emmake make -j$(nproc) && \
    cp /src/web/mock-server.js /src/build-emscripten/src/bzflag/

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy WASM build artifacts
COPY --from=build /src/build-emscripten/src/bzflag/bzflag.html /usr/share/nginx/html/index.html
COPY --from=build /src/build-emscripten/src/bzflag/bzflag.js /usr/share/nginx/html/
COPY --from=build /src/build-emscripten/src/bzflag/bzflag.wasm /usr/share/nginx/html/
COPY --from=build /src/build-emscripten/src/bzflag/bzflag.data /usr/share/nginx/html/
COPY --from=build /src/build-emscripten/src/bzflag/mock-server.js /usr/share/nginx/html/

# Configure nginx for WASM MIME types and WebSocket proxy support
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Include standard MIME types + WASM
    include /etc/nginx/mime.types;
    types {
        application/wasm wasm;
    }

    # Enable gzip for large assets
    gzip on;
    gzip_types application/javascript application/wasm application/octet-stream;
    gzip_min_length 1000;

    # Cache static assets
    location ~* \.(wasm|data|js)$ {
        expires 1h;
        add_header Cache-Control "public, immutable";
    }

    # WebSocket proxy for multiplayer (optional)
    # Uncomment and set upstream to your bzfs WebSocket proxy
    # location /ws {
    #     proxy_pass http://ws-proxy:5201;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    # }
}
NGINX

EXPOSE 80
